{
  "client": "Thunder Client",
  "collectionName": "LuxeWatch API",
  "folder": [
    {
      "name": "Products",
      "requests": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/products",
            "headers": []
          }
        },
        {
          "name": "Get Men Products",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/products?category=men",
            "headers": []
          }
        },
        {
          "name": "Get Women Products",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/products?category=women",
            "headers": []
          }
        },
        {
          "name": "Get Products by Brand",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/products?brand=Rolex",
            "headers": []
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/products/1",
            "headers": []
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "url": "http://localhost:5000/api/products",
            "headers": [
              { "name": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "type": "json",
              "raw": "{ \"id\": 15, \"name\": \"Test Watch\", \"brand\": \"TestBrand\", \"price\": 999, \"image\": \"https://example.com/watch.jpg\", \"category\": \"men\", \"description\": \"A test product\" }"
            }
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "url": "http://localhost:5000/api/products/15",
            "headers": [
              { "name": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "type": "json",
              "raw": "{ \"price\": 1099, \"name\": \"Test Watch Updated\" }"
            }
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:5000/api/products/15",
            "headers": []
          }
        }
      ]
    },
